# .gitattributes — line-ending and diff hygiene for a cross-platform repo
# (Windows working copies + Linux containers). The key goal: anything that
# runs inside a container MUST stay LF, or you get `/bin/sh^M: bad interpreter`.

# Default: let Git normalise text files to LF in the repo, and check them out
# with the platform's native endings in the working tree.
* text=auto

# ── Must be LF (executed inside Linux containers / by sh/bash) ──────────────
*.sh            text eol=lf
*.bash          text eol=lf
Dockerfile      text eol=lf
*.dockerfile    text eol=lf
.env*           text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.hcl           text eol=lf
entrypoint*     text eol=lf
*.conf          text eol=lf

# ── Windows-native (leave CRLF) ─────────────────────────────────────────────
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# ── Binary: never touch, never diff ─────────────────────────────────────────
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.zip           binary
*.gz            binary
*.jar           binary
*.keystore      binary
*.p12           binary
*.gpg           binary